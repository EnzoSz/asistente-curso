# ---------------------------------------------------------------
# Plantilla de configuración - Módulo 3, Clase 4 (BACKEND)
# ---------------------------------------------------------------
# Copiá este archivo con el nombre .env y pegá tus claves abajo.
# Las claves viven SOLO en el backend: el front no las ve nunca.
# El archivo .env NUNCA se sube a GitHub (ya está en .gitignore).
# En Render, estas mismas variables se cargan en Environment.
# ---------------------------------------------------------------

# Las mismas claves de la clase 3: copialas de ese .env.
LANGSMITH_API_KEY=
# El modelo que contesta (Claude) y los embeddings del RAG (Gemini).
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# La observabilidad: agente y entorno.
LANGSMITH_TRACING=true
LANGSMITH_AGENT_ID=asistente-del-curso
# En tu computadora: local (tus pruebas). En Render: production (la web
# de verdad). Mismo código, trazas separadas.
LANGSMITH_AGENT_ENVIRONMENT=local

# Qué versión del agente atiende la API: v1 o v2.
VERSION_AGENTE=v1

# La clave para usar la API (la inventás vos). Vacía: la API está
# abierta, como en la clase 3. En Render, poné una larga y secreta, y la
# misma en el front.
CLAVE_API=
