# ---------------------------------------------------------------
# Plantilla de configuración - Módulo 3, Clase 4 (FRONTEND)
# ---------------------------------------------------------------
# El front NO lleva las claves de NVIDIA ni de LangSmith: solo sabe
# dónde está el backend. En Streamlit Community Cloud, estas dos líneas
# van en Advanced settings > Secrets, con comillas:
#   URL_BACKEND = "https://asistente-xxxx.onrender.com"
#   CLAVE_API = "la-misma-de-render"
# ---------------------------------------------------------------
URL_BACKEND=http://127.0.0.1:8000
CLAVE_API=
